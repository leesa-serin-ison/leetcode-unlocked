class Solution:
    def commonFactors(self, a: int, b: int) -> int:
        count=0
        if(a>b):
            n1=int(a/2)
        elif(a<b):
            n1=int(b/2)
        else:
            n1=a


        for i in range(1,n1+1):
            if(a%i==0 and b%i==0):
                count=count+1
        return count
