class Solution:
    def averageValue(self, nums: List[int]) -> int:
        n=len(nums)
        sum=0
        count=0
        for i in range(n):
            if(nums[i]%2==0 and nums[i]%3==0):
                sum=sum+nums[i]
                count=count+1
        if count==0:
            return 0
        else:
            avg=sum//count
            return avg

        
