class Solution:
    def returnToBoundaryCount(self, nums: List[int]) -> int:
        sum=0
        count=0
        n=len(nums)
        for i in range(n):
            sum=sum+nums[i]
            if(sum==0):
                count=count+1
        if count==0:
            return 0
        else:
            return count    
        
